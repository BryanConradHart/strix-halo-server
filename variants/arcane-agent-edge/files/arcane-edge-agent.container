[Unit]
Description=Arcane Edge Agent
ConditionPathExists=/etc/arcane/agent.env
Requires=podman.socket
After=podman.socket

[Container]
Image=ghcr.io/getarcaneapp/agent:latest
ContainerName=arcane-edge-agent
AutoUpdate=registry
Environment=EDGE_AGENT=true
Environment=EDGE_TRANSPORT=poll
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
EnvironmentFile=/etc/arcane/agent.env
SecurityLabelDisable=true
Volume=/run/podman/podman.sock:/var/run/docker.sock
Volume=/run/dbus/system_bus_socket:/run/dbus/system_bus_socket
Volume=/etc/containers/systemd:/etc/containers/systemd:rw
Volume=arcane-edge-agent-data:/app/data

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
