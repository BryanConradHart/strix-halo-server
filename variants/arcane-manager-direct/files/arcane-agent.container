[Unit]
Description=Arcane Direct Agent
ConditionPathExists=/etc/arcane/agent.env
Requires=podman.socket
After=podman.socket

[Container]
Image=ghcr.io/getarcaneapp/agent:latest
ContainerName=arcane-agent
Environment=AGENT_MODE=true
EnvironmentFile=/etc/arcane/agent.env
PublishPort=3553:3553
SecurityLabelDisable=true
Volume=/run/podman/podman.sock:/var/run/docker.sock
Volume=arcane-agent-data:/app/data

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
