variant: fcos
version: 1.4.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - YOUR_SSH_PUB_KEY_HERE
      password_hash: YOUR_GOOD_PASSWORD_HASH_HERE
storage:
  directories:
    - path: /etc/ucore-autorebase
      mode: 0754
  # Variant-specific credential files are inserted by the setup builder.
  YOUR_VARIANT_STORAGE_HERE
# provision the kargs in butane as well as in bootc, so it works when provisioning via ostree or bootc
kernel_arguments:
  should_exist:
    - amdgpu.gttsize=126976
    - ttm.pages_limit=32505856
    - ttm.page_pool_size=32505856
    - amdttm.pages_limit=32505856
    - amdttm.page_pool_size=32505856
    - iommu=pt
systemd:
  units:
    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=Rebase to selected Strix Halo image and reboot
        ConditionPathExists=!/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:YOUR_STRIX_IMAGE_REF_HERE
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
    # Variant-specific application services are enabled by the setup builder.
    YOUR_VARIANT_SYSTEMD_HERE
    - name: ucore-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=Rebase to selected signed Strix Halo image and reboot
        ConditionPathExists=/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://YOUR_STRIX_IMAGE_REF_HERE
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/signed
        ExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
